---
// A screenshot in the visitor's own theme: the dark one under a dark system
// setting, the light one otherwise. Plain <picture>, no script.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  class?: string;
}

const { light, dark, alt, widths, sizes, eager = false, class: className } = Astro.props;
const options = { widths, format: "webp" as const, quality: 82 };
const [lit, dim] = await Promise.all([
  getImage({ src: light, ...options }),
  getImage({ src: dark, ...options }),
]);
---

<picture class={className}>
  <source media="(prefers-color-scheme: dark)" srcset={dim.srcSet.attribute} sizes={sizes} type="image/webp" />
  <img
    src={lit.src}
    srcset={lit.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={light.width}
    height={light.height}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
</picture>
