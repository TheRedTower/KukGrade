# Copy to .env.production on the deployment host and keep that file private.
# Compose reads this file for substitutions when passed --env-file and for
# container settings through the app service's env_file.
# Traefik uses apps_net, websecure and cloudflare in compose.prod.yml.
# Existing PostgreSQL container's shared Docker network and network alias.
POSTGRES_NETWORK=replace-with-postgres-network
POSTGRES_HOST=replace-with-postgres-alias
POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-long-random-password

DJANGO_SECRET_KEY=replace-with-a-separate-long-random-secret
DJANGO_ALLOWED_HOSTS=www.kukgrade.co.uk
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.kukgrade.co.uk
DJANGO_CORS_ALLOWED_ORIGINS=
# The club's time zone (an IANA name): the one setting for it. Dates such as
# "today" and a student's age are taken in it, and the screens show times in it.
# Defaults to Europe/London.
TZ=Europe/London
# The club name shown in the application's sidebar.
KUKGRADE_CLUB_NAME=Kuk Sool Won Colchester
# The school's prefix in its student IDs (206-2-150). Defaults to 206-2.
# KUKGRADE_SCHOOL_PREFIX=206-2
# How many hours a temporary password an administrator issues keeps working
# (at least 1). Defaults to 24.
# KUKGRADE_TEMPORARY_PASSWORD_HOURS=24
# How many reverse proxies or tunnels sit in front, each trusted: here
# Cloudflare, then Traefik. 0 means the app is reached directly (see
# docs/deployment.md, "How the app is reached").
DJANGO_NUM_PROXIES=2
# The port the app listens on inside the container, which Traefik routes to
# (nothing is published on the host here). Defaults to 6942.
# KUKGRADE_PORT=6942
