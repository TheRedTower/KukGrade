# Copy to .env (Git and Docker builds ignore it) and fill it in. This one file is
# all the setup there is.

# A long random value: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave it out and the app makes one on first start and keeps it in data/.
# DJANGO_SECRET_KEY=

# The names people type to reach it (no scheme, no port), and the same addresses
# as the browser shows them, with scheme and port.
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:6942

KUKGRADE_CLUB_NAME=Kuk Sool Won
TZ=Europe/London

# Behind a proxy or tunnel (any file but compose.yml): how many are in front.
# DJANGO_NUM_PROXIES=1
# Directly on a network you trust, without HTTPS: uncomment instead.
# KUKGRADE_TRANSPORT=http

# Only for the file you use:
# compose.caddy.yml        KUKGRADE_DOMAIN=
# compose.traefik.yml      TRAEFIK_NETWORK=   KUKGRADE_HOST=
# compose.cloudflared.yml  TUNNEL_TOKEN=
# compose.pangolin.yml     PANGOLIN_ENDPOINT=   NEWT_ID=   NEWT_SECRET=

# Using a PostgreSQL you already run instead of the one in the image: set
# POSTGRES_HOST (and POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD).
