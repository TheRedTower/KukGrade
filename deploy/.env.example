# Copy to deploy/.env and keep that file private (Git ignores it, and Docker
# builds leave it out). Compose reads it for the app and for the bundled database.

# --- Database -------------------------------------------------------------
# With compose.bundled-db.yml these create the database. To use a PostgreSQL you
# already run instead, leave that file out and also set POSTGRES_HOST (and
# POSTGRES_PORT if it is not 5432): the app must be able to reach it.
POSTGRES_DB=kukgrade
POSTGRES_USER=kukgrade
POSTGRES_PASSWORD=replace-with-a-long-random-password
# POSTGRES_HOST=

# --- The app --------------------------------------------------------------
# A fresh random value: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-separate-long-random-secret
# The names people type to reach it, comma-separated (no scheme, no port).
DJANGO_ALLOWED_HOSTS=localhost
# The same addresses with their scheme and port, as the browser shows them, for
# example https://kukgrade.example.com or https://localhost:6942.
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:6942
# Blank on purpose: the browser only talks to the address it loaded KukGrade from.
DJANGO_CORS_ALLOWED_ORIGINS=
KUKGRADE_CLUB_NAME=Kuk Sool Won
TZ=Europe/London

# --- How it is reached ----------------------------------------------------
# Leave these alone with no proxy: the app serves HTTPS itself on port 6942
# (a self-signed certificate it makes, or yours: see docs/deployment.md). A
# proxy file under proxies/ sets DJANGO_NUM_PROXIES for you.
# KUKGRADE_TRANSPORT=https
# DJANGO_NUM_PROXIES=1

# --- Only for the proxy file you use (Compose needs these for every command) -
# proxies/traefik.yml:     TRAEFIK_NETWORK=   KUKGRADE_HOST=
# proxies/caddy.yml:       KUKGRADE_DOMAIN=
# proxies/cloudflared.yml: CLOUDFLARE_TUNNEL_TOKEN=
# proxies/pangolin.yml:    PANGOLIN_ENDPOINT=   NEWT_ID=   NEWT_SECRET=
