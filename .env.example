# Required whenever DJANGO_DEBUG is false. The application refuses to start
# without it rather than falling back to a known key. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=replace-with-a-local-development-secret

# Defaults to false. Set true for local development only.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax

POSTGRES_DB=kukgrade
POSTGRES_USER=kukgrade
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

VITE_API_BASE_URL=http://localhost:8000

# The club's time zone (an IANA name). Dates such as "today" and a student's
# age are taken in it, and the screens show times in it. Defaults to
# Europe/London. (A TZ already set in your shell applies here too.)
# TZ=Europe/London

# The club name shown in the application's sidebar.
KUKGRADE_CLUB_NAME=Kuk Sool Won Colchester
# The school's prefix in its student IDs (206-2-150). Defaults to 206-2.
# KUKGRADE_SCHOOL_PREFIX=206-2

# How many hours a temporary password an administrator issues keeps working
# (at least 1). Defaults to 24.
# KUKGRADE_TEMPORARY_PASSWORD_HOURS=24

# Transport security. Each defaults to the secure value when DJANGO_DEBUG is
# false, so these only need setting to opt out.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Preload is off by default; see settings.py before enabling it.
# DJANGO_SECURE_HSTS_PRELOAD=false
# How many reverse proxies or tunnels sit in front, each trusted (0: none).
# Only declare proxies that are guaranteed to overwrite any client-supplied
# X-Forwarded-For and X-Forwarded-Proto: trusting them otherwise lets a client
# choose its address and pose as an already-secure request.
# DJANGO_NUM_PROXIES=0
# With no proxy in front: https (the app serves HTTPS itself) or http (plain,
# only for a network you trust). See docs/deployment.md, "How the app is reached".
# KUKGRADE_TRANSPORT=https
