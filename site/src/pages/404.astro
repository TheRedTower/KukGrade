---
import logo from "../assets/logo.svg?raw";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · KukGrade" description="This page does not exist.">
  <header class="top wrap">
    <a class="brand" href="/" aria-label="KukGrade, home"><span class="logo" set:html={logo} /></a>
  </header>
  <main id="main" class="wrap band lost">
    <h1>Page not found</h1>
    <p class="lede">There is nothing at this address.</p>
    <div class="actions">
      <a class="btn btn--primary" href="/">Go to the home page</a>
    </div>
  </main>
</Base>
