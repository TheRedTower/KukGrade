# Editor settings the repository's formatters agree with (Ruff, Prettier).
# https://editorconfig.org - most editors read it; VS Code needs the extension
# in .vscode/extensions.json.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi,sh}]
indent_size = 4

[Dockerfile]
indent_size = 4

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
